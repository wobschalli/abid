#ignore docker files
/.dockerignore
/Dockerfile*
/docker-compose*.yml

#ignore assets (rebuilt inside the image)
/node_modules/

#ignore git stuff
/.gitignore
/.git
/.github

#ignore editor/tooling state
/.idea/
/tmp/
/.rake_tasks~

#ignore secrets (supplied at runtime via env / bind mounts)
/.env*
/master.key
/.session_secret
/config.yml
/config2.yml
