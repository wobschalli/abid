# Copy to `.env.local` for local development. Gitignored, never committed.
# bin/bot and bin/dev source this file automatically.

# Token for your separate "beta" Discord application. When set, the bot uses
# this instead of the token seeded into the discord_infos table, so you can
# develop against a test bot without touching production.
DISCORD_TOKEN=

# Which config file `rake db:seed` reads (channel/server/emoji IDs for the
# beta bot's servers).
CONFIG_FILE=config2.yml

# Local Postgres (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=abid_development
