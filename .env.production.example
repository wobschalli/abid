# Copy to `.env` on the server, in the same directory as docker-compose.prod.yml.
# Never commit the real file.

# Image built and pushed by .github/workflows/deploy.yml
APP_IMAGE=ghcr.io/wobschalli/abid:latest

# Port the web interface is published on (put nginx/Caddy in front for TLS)
WEB_PORT=4455

# Postgres
DB_NAME=abid_production
DB_USER=postgres
DB_PASSWORD=change-me

# Sinatra session signing key. Generate with:
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SESSION_SECRET=change-me

# Leave empty in production: the bot reads its token from the seeded
# discord_infos row. Only set this if you deliberately want to run the
# beta bot on the server.
DISCORD_TOKEN=
