#!/usr/bin/env bash
# Everything that does not need root: gems, node packages, session secret,
# database, demo data. Run bin/setup-deps first if this complains.
set -euo pipefail

cd "$(dirname "$0")/.."

info() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

missing=""
have ruby || missing="$missing ruby"
have bundle || missing="$missing bundler"
[ -f /usr/include/libpq-fe.h ] || missing="$missing libpq-dev"

if [ -n "$missing" ]; then
  cat >&2 <<EOF

Missing system dependencies:$missing

These need root, so run this once in a real terminal:

  bin/setup-deps

then run bin/setup again.
EOF
  exit 1
fi

info "Ruby $(ruby -v)"

info 'Installing gems'
bundle install

info 'Installing node packages'
if have yarn; then yarn install; else npm install; fi

if ! (timeout 2 bash -c '</dev/tcp/127.0.0.1/5432') 2>/dev/null; then
  echo "Postgres is not listening on 5432. Start it with: sudo service postgresql start" >&2
  exit 1
fi

if [ ! -f .session_secret ]; then
  info 'Generating .session_secret'
  ruby -rsecurerandom -e 'print SecureRandom.hex(64)' > .session_secret
fi

info 'Creating and migrating the database'
bundle exec rake db:create
bundle exec rake db:migrate

info 'Loading demo data'
bundle exec rake db:demo

cat <<'DONE'

Setup complete.

  bin/dev      start the web app on http://localhost:5544
  bin/console  IRB with the models loaded

Log in at /login as "alan" with password "ridedemo", then open /board.

The Discord bot (bin/bot) additionally needs DISCORD_TOKEN and a config.yml;
it is not required to work on the dashboard.
DONE
