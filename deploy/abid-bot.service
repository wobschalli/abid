# The Discord bot: sign-up posting, reactions, dispatch DMs, the late-rider
# optimizer sweep. EXACTLY ONE instance may run anywhere — a second bot posts
# every sign-up twice. Stop any other copy before starting this one.
[Unit]
Description=Abid Discord bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=abid
Group=abid
WorkingDirectory=/opt/abid
EnvironmentFile=/etc/abid/env
Environment=RBENV_ROOT=/usr/local/rbenv
Environment=PATH=/usr/local/rbenv/shims:/usr/local/rbenv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/rbenv/shims/bundle exec ruby bot/run.rb
# bot/run.rb traps INT/TERM and closes the gateway cleanly.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
