# The Discord bot: sign-up posting, reactions, dispatch DMs, the late-rider
# optimizer sweep. EXACTLY ONE instance may run anywhere — a second bot posts
# every sign-up twice. Stop any other copy before starting this one.
[Unit]
Description=Abid Discord bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=abid
Group=abid
WorkingDirectory=/opt/abid
EnvironmentFile=/etc/abid/env
Environment=PATH=/opt/ruby/3.3.8/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/ruby/3.3.8/bin/bundle exec ruby bot/run.rb
# bot/run.rb traps INT/TERM and closes the gateway cleanly.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
