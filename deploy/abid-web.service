# The dashboard. Binds to localhost only; nginx terminates TLS in front of it
# and routes /abidebot/ here. Installed by deploy/install.sh.
[Unit]
Description=Abid rides dashboard (puma)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=abid
Group=abid
WorkingDirectory=/opt/abid
EnvironmentFile=/etc/abid/env
# Ruby is installed system-wide (deploy/install.sh), so it is not tied to any
# user's home and the service account needs no shell.
Environment=PATH=/opt/ruby/3.3.8/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/ruby/3.3.8/bin/bundle exec puma -e production -b tcp://127.0.0.1:5544 -t 2:5
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
