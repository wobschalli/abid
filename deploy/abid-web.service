# The dashboard. Puma on a unix socket; nginx (deploy/nginx-abid.conf)
# terminates TLS and routes /abidebot/ to it. Installed by deploy/install.sh.
[Unit]
Description=Abid rides dashboard (puma)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=abid
Group=abid
WorkingDirectory=/opt/abid
# RACK_ENV, database credentials, session secret, ABID_ROOT_PATH. Without this
# the app boots in development mode against database.yml's defaults and dies.
EnvironmentFile=/etc/abid/env
# Ruby 3.3.8 from the system-wide rbenv the server was set up with.
Environment=RBENV_ROOT=/usr/local/rbenv
Environment=PATH=/usr/local/rbenv/shims:/usr/local/rbenv/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/mkdir -p /opt/abid/tmp/sockets
ExecStart=/usr/local/rbenv/shims/bundle exec puma -e production -b unix:///opt/abid/tmp/sockets/abid-web.sock -t 2:5
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
