# /etc/abid/env — read by both systemd units. chmod 600, owned by root:abid.
# Everything here is a secret or a machine-specific setting; nothing in this
# file belongs in git.

RACK_ENV=production
BOT_ENV=production

# Postgres. The role and database are created by deploy/install.sh.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abid_production
DB_USER=abid
DB_PASSWORD=CHANGE_ME_long_random

# Cookie signing. Generate once: openssl rand -hex 64
ABID_SESSION_SECRET=CHANGE_ME_128_hex_chars

# Optional overrides. The Discord token and Google key live in config.yml in
# the app directory (chmod 600), exactly as on the laptop; set these only to
# override that file.
# DISCORD_TOKEN=
# GOOGLE_MAPS_KEY=

# Scheduling is in Indiana time regardless of the server's clock.
ABID_TZ=America/Indiana/Indianapolis
